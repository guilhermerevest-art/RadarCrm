# =============================================================================
# EPIC 12: API Pública e Escala
# Variáveis de ambiente necessárias
# =============================================================================

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Cron Secret (para processar webhooks via cron)
CRON_SECRET=generate_a_secure_random_string

# =============================================================================
# Configuração de API
# =============================================================================

# Número máximo de requisições por minuto por API key
API_RATE_LIMIT=100

# =============================================================================
# Exemplo de configuração Upstash Redis
# =============================================================================

# 1. Crie uma conta em https://upstash.com
# 2. Crie um banco Redis
# 3. Copie as variáveis REST_URL e REST_TOKEN
# 4. Cole aqui:
#
# UPSTASH_REDIS_REST_URL=https://us1-pleasant-turkey-12345.upstash.io
# UPSTASH_REDIS_REST_TOKEN=Ack.......
